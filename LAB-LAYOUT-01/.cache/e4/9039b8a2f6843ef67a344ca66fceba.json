ken-values, $i));\n      background-color: $darkened;\n      color: #fff;\n    }\n  \n    .lighten-#{$i} {\n      $lightened: color.adjust($base-color, $lightness: list.nth($lighten-values, $i));\n      background-color: $lightened;\n      color: #000;\n    }\n  }\n}\n\n// Estilos base\n\n.container {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  margin-bottom: 30px;\n}\n\n.box {\n  width: 100px;\n  height: 100px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-weight: bold;\n  border-radius: 8px;\n}\n\n.color-box-text {\n  font-size: 12px;\n  text-align: center;\n  padding: 5px;\n}\n\n// Aplicamos el mixing para cada background\n.container-1 {\n  @include color-variations($base-color-1, 1);\n}\n\n.container-2 {\n  @include color-variations($base-color-2, 2);\n}\n\n.container-3 {\n  @include color-variations($base-color-3, 3);\n}"},"lineCount":null}},"error":null,"hash":"a2cdc232facd06a31f4e9903251cfb10","cacheData":{"env":{}}}